  "@type": "sc:Dataset",
  "name": "data/input/review-decisions.csv",
  "description": "Reviewers' decisions on the atlas review items (table review_item of graph/build/graph.sqlite). One row per decided item; the next build applies each decision and exports the item as resolved.",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "review-decisions.csv",
      "name": "review-decisions.csv",
      "contentSize": "19",
      "contentUrl": "data/input/review-decisions.csv",
      "encodingFormat": "text/csv",
      "sha256": "32e0e23d6076835133e7b6c468e2e0071e8767719807047911321ab0ba8e4460"
    }
  ],
  "dateCreated": "2026-11-10T17:37:11.972133+00:00",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "version": "1.0.0",
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "review-decisions.csv#review-decisions",
      "name": "review-decisions",
      "description": "One decision per review item.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "review-decisions.csv#review-decisions/review_id",
          "name": "review_id",
          "description": "The review_item id exactly as the build exported it, e.g. review:person_match:0123456789abcdef.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "review-decisions.csv"
            },
            "extract": {
              "column": "review_id"
            }
          },
          "biotope:fromData": {
            "description": "Column 'review_id' from review-decisions.csv"
          }
        },
        {
          "@type": "cr:Field",
          "@id": "review-decisions.csv#review-decisions/decision",
          "name": "decision",
          "description": "For person_match, organisation_match and initiative_match items, 'same' (join them) or 'different' (keep them apart). For value_conflict items, the correct value as text (a date as YYYY, YYYY-MM or YYYY-MM-DD for start, end and date conflicts, which the build then uses), or 'all valid' when the sources are each right for their time.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "review-decisions.csv"
            },
            "extract": {
              "column": "decision"
            }
          },
          "biotope:fromData": {
            "description": "Column 'decision' from review-decisions.csv"
          }
        }
      ],
      "biotope:namedAfterFile": true,
      "biotope:fromData": {
        "description": "Records from review-decisions.csv",
        "key": null
      },
      "key": {
        "@id": "review-decisions.csv#review-decisions/review_id"
      }
    }
  ],
  "biotope:status": "processed",
  "biotope:fromData": {
    "description": "Dataset for review-decisions.csv"
  }
