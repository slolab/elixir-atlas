  "@type": "sc:Dataset",
  "name": "data/input/corrections.csv",
  "description": "Corrections that a Node or another person who knows the facts has confirmed. They take precedence over every other source for the fact they name. Each build applies them before it derives leaders, Node involvement and kinds, and reports any correction whose subject or target the build does not have.",
  "distribution": [
    {
      "@type": "cr:FileObject",
      "@id": "corrections.csv",
      "name": "corrections.csv",
      "contentSize": "1493",
      "contentUrl": "data/input/corrections.csv",
      "encodingFormat": "text/csv",
      "sha256": "4b7823d1eee68d1329443ce98d029994889819b106ddf71d7278e297aa9559da"
    }
  ],
  "dateCreated": "2026-11-13T09:07:59.103705+00:00",
  "conformsTo": "http://mlcommons.org/croissant/1.1",
  "version": "1.0.0",
  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "corrections.csv#corrections",
      "name": "corrections",
      "description": "One confirmed correction per row.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "corrections.csv#corrections/subject",
          "name": "subject",
          "description": "The Atlas id the correction is about, such as person:tim-beck or initiative:eosc-entrust.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "corrections.csv"
            },
            "extract": {
              "column": "subject"
            }
