            "description": "Column 'subject' from corrections.csv"
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corrections.csv#corrections/property",
          "name": "property",
          "description": "node (the person's ELIXIR Node), role (the person's role in an initiative) or kind (an initiative's kind).",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "corrections.csv"
            },
            "extract": {
              "column": "property"
            }
          },
          "biotope:fromData": {
            "description": "Column 'property' from corrections.csv"
          }
        },
        {
          "@type": "cr:Field",
          "@id": "corrections.csv#corrections/action",
          "name": "action",
          "description": "add or remove for node and role; set for kind.",
