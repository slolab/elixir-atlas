  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "plan_items.jsonl#plan_items",
      "name": "plan_items.jsonl",
      "description": "PlanItem records extracted from documents. A unit of planned or reported work of an ELIXIR group or project, as one document states it: work packages, tasks and activities, deliverables and milestones, events (meetings, workshops, hackathons, webinars, courses), outputs (publications, tools, standards, guidelines, reports), goals and roadmap actions, and items reported as still open. One record per item. Leave out general background and work of organisations outside ELIXIR.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "plan_items.jsonl#plan_items/id",
          "name": "id",
          "description": "The record ID: the document's dataset folder and its path within it, then the record key's values.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "plan_items.jsonl"
            },
            "extract": {
              "column": "id"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "plan_items.jsonl#plan_items/document",
          "name": "document",
