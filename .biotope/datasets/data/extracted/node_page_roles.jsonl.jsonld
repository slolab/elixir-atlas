  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "node_page_roles.jsonl#node_page_roles",
      "name": "node_page_roles.jsonl",
      "description": "NodePageRole records extracted from documents. A person's role, membership or position as an ELIXIR-UK people or activity page shows it in the page's structure: the title under the name, the organisation, the ORCID link, governance roles, the groups the person leads ('Community leadership'), the groups, clubs and projects listed on the profile, and the 'Coordination / leads' of an activity page. Read by code, not by a language model.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/id",
          "name": "id",
          "description": "The record ID: the document's dataset folder and its path within it, then the record key's values.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "id"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/document",
          "name": "document",
          "description": "The document's path in the project.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "document"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/person",
          "name": "person",
          "description": "The person's name without titles such as Dr or Prof.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "values/person/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/role",
          "name": "role",
          "description": "The role as the page writes it, or 'member' for a listed group.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "values/role/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/role_kind",
          "name": "role_kind",
          "description": "The kind of role, as in role_statements.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "values/role_kind/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/place",
          "name": "place",
          "description": "The group, project, Node or body where the person holds the role.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "values/place/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/place_kind",
          "name": "place_kind",
          "description": "What kind of place the role is held in.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "values/place_kind/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/affiliation",
          "name": "affiliation",
          "description": "The person's organisation as the page writes it.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "values/affiliation/value"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/node",
          "name": "node",
          "description": "ELIXIR-UK when the person's organisation is listed as an ELIXIR-UK member, else null.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "values/node/value"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "node_page_roles.jsonl#node_page_roles/orcid",
          "name": "orcid",
          "description": "The ORCID iD the profile links to.",
