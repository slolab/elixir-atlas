          "source": {
            "fileObject": {
              "@id": "node_page_roles.jsonl"
            },
            "extract": {
              "column": "values/orcid/value"
            }
          }
        }
      ],
      "biotope:namedAfterFile": true,
      "key": {
        "@id": "node_page_roles.jsonl#node_page_roles/id"
      }
