  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "recommendations.jsonl#recommendations",
      "name": "recommendations.jsonl",
      "description": "Recommendation records extracted from documents. A tool, database, standard, guideline, practice or training resource that an ELIXIR Community page or a Community paper (white paper, meeting report, recommendations paper, service bundle) recommends, endorses, develops or lists as a resource for its field. One record per resource and group. Leave out resources only cited as related work or background, used once as an example, or reachable only through a catalogue the document links to without naming the resource.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "recommendations.jsonl#recommendations/id",
          "name": "id",
          "description": "The record ID: the document's dataset folder and its path within it, then the record key's values.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "recommendations.jsonl"
            },
            "extract": {
              "column": "id"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "recommendations.jsonl#recommendations/document",
          "name": "document",
          "description": "The document's path in the project.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "recommendations.jsonl"
            },
            "extract": {
              "column": "document"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "recommendations.jsonl#recommendations/resource",
          "name": "resource",
          "description": "The resource's name as written, e.g. 'MEMOTE', 'SBML', 'standard-GEM'.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "recommendations.jsonl"
            },
            "extract": {
              "column": "values/resource/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "recommendations.jsonl#recommendations/kind",
          "name": "kind",
          "description": "tool is software; database a data resource or repository; standard a format, ontology or minimum-information checklist; guideline a set of recommendations or a scorecard; practice a way of working; training a course or material; document a paper or report to read.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "recommendations.jsonl"
            },
            "extract": {
              "column": "values/kind/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "recommendations.jsonl#recommendations/group",
          "name": "group",
          "description": "The ELIXIR Community or group whose page or paper names the resource, as written.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "recommendations.jsonl"
            },
            "extract": {
              "column": "values/group/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "recommendations.jsonl#recommendations/basis",
          "name": "basis",
          "description": "recommends when the document recommends, endorses or calls it a community standard or best practice; develops when the group or its members develop or maintain it; lists when it is only listed among the group's resources.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "recommendations.jsonl"
            },
            "extract": {
              "column": "values/basis/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "recommendations.jsonl#recommendations/purpose",
          "name": "purpose",
          "description": "What the document says the resource is for, as a short phrase close to its wording, e.g. 'testing the quality of genome-scale metabolic models'.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "recommendations.jsonl"
            },
            "extract": {
              "column": "values/purpose/value"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "recommendations.jsonl#recommendations/url",
          "name": "url",
          "description": "The link the document gives for the resource.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "recommendations.jsonl"
            },
            "extract": {
              "column": "values/url/value"
            }
          }
        }
      ],
      "biotope:namedAfterFile": true,
      "key": {
        "@id": "recommendations.jsonl#recommendations/id"
      }
    }
