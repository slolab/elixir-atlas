  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "plan_links.jsonl#plan_links",
      "name": "plan_links.jsonl",
      "description": "PlanLink records extracted from documents. A statement in a group's or project's work plan, page or report that links its work, or one of its work packages, tasks, activities or deliverables, to another ELIXIR project or group, or to a work package, task or deliverable of another project: complements, builds on, contributes to, feeds into, is aligned with, is delivered together with. One record per linked pair. Leave out links between work items of the same project, funding acknowledgements, and lists of partners or related projects that state no shared work.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "plan_links.jsonl#plan_links/id",
          "name": "id",
          "description": "The record ID: the document's dataset folder and its path within it, then the record key's values.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
