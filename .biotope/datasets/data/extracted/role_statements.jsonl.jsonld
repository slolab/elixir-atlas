  "recordSet": [
    {
      "@type": "cr:RecordSet",
      "@id": "role_statements.jsonl#role_statements",
      "name": "role_statements.jsonl",
      "description": "RoleStatement records extracted from documents. A named person's role, membership or position in ELIXIR, as one document states it: leads, co-leads, chairs, coordinators, Hub liaisons, work package and task leaders and deputies, contact persons, Heads of Node, Node coordinators and staff, and members and participants of groups and projects. One record per person, role and place. Leave out authors of cited works, people only thanked or quoted, and roles without a named person.",
      "field": [
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/id",
          "name": "id",
          "description": "The record ID: the document's dataset folder and its path within it, then the record key's values.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "id"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/document",
          "name": "document",
          "description": "The document's path in the project.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "document"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/person",
          "name": "person",
          "description": "The person's full name as written, without titles such as Dr or Prof.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/person/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/role",
          "name": "role",
          "description": "The role as written, e.g. 'Co-lead', 'WP4 co-leader', 'Platform Coordinator (interim)', 'Head of Node'; 'member' when the document lists the person without a role.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/role/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/role_kind",
          "name": "role_kind",
          "description": "The kind of role. liaison is a Hub officer supporting a group; staff is employment at a Node or the Hub; member and participant are for people listed without a leading role.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/role_kind/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/place",
          "name": "place",
          "description": "The group, project, work package, task, Node, Hub or body where the person holds the role, as written, e.g. 'Systems Biology Community', 'ELIXIR-STEERS', 'ELIXIR Switzerland'. For a work package or task, the project it belongs to.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/place/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/place_kind",
          "name": "place_kind",
          "description": "What kind of place the role is held in.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/place_kind/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/work_item",
          "name": "work_item",
          "description": "Code and title of the work package, task or activity the role is in, e.g. 'WP4 Multi-Cloud Infrastructure Deployment', 'Task 4.2'.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/work_item/value"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/affiliation",
          "name": "affiliation",
          "description": "The person's organisation, as written.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/affiliation/value"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/node",
          "name": "node",
          "description": "The ELIXIR Node the document associates with the person, e.g. 'ELIXIR Slovenia' or 'ELIXIR Hub', as written.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/node/value"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/period",
          "name": "period",
          "description": "When the person holds the role, as written.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/period/value"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/effort",
          "name": "effort",
          "description": "Time the person commits to the role, as written: FTE, person-months or percent. Never estimated.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/effort/value"
            }
          }
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/funding",
          "name": "funding",
          "description": "funded or in_kind only when the document states it for this person's work in this role; otherwise not_stated. Funding of the person's organisation does not count.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/funding/value"
            }
          },
          "biotope:nullable": false
        },
        {
          "@type": "cr:Field",
          "@id": "role_statements.jsonl#role_statements/email",
          "name": "email",
          "description": "The person's email address, if the document gives it.",
          "dataType": "sc:Text",
          "source": {
            "fileObject": {
              "@id": "role_statements.jsonl"
            },
            "extract": {
              "column": "values/email/value"
            }
          }
        }
      ],
      "biotope:namedAfterFile": true,
      "key": {
        "@id": "role_statements.jsonl#role_statements/id"
      }
    }
  ],
